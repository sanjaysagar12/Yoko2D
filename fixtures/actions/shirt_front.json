{
  "measurements_path": "fixtures/measurements/shirt_front.json",
  "actions": [
    { "op": "add_base_point", "name": "A1", "x": 0.0, "y": 0.0 },

    { "op": "add_end_line", "name": "A2", "base_point": "A1", "angle_formula": "-90", "length_formula": "front_neck_depth" },
    { "op": "add_end_line", "name": "A3", "base_point": "A1", "angle_formula": "-90", "length_formula": "armhole_depth" },
    { "op": "add_end_line", "name": "A4", "base_point": "A1", "angle_formula": "-90", "length_formula": "body_length" },
    { "op": "add_end_line", "name": "A5", "base_point": "A1", "angle_formula": "0", "length_formula": "neck_width" },

    { "op": "add_end_line", "name": "A6", "base_point": "A5", "angle_formula": "-atan(shoulder_drop/(shoulder_width-neck_width))", "length_formula": "3" },
    { "op": "add_shoulder_point", "name": "A7", "p1_line": "A5", "p2_line": "A6", "shoulder": "A1", "length_formula": "sqrt(shoulder_width^2+shoulder_drop^2)" },

    { "op": "add_end_line", "name": "A8", "base_point": "A3", "angle_formula": "0", "length_formula": "half_chest" },
    { "op": "add_end_line", "name": "A9", "base_point": "A8", "angle_formula": "-90", "length_formula": "body_length-armhole_depth" },

    { "op": "add_point_of_intersection", "name": "A10", "p1": "A5", "p2": "A2" },

    { "op": "add_spline", "name": "NeckCurve", "p1": "A5", "p4": "A2",
      "angle1_formula": "-90", "length1_formula": "front_neck_depth*2/3",
      "angle2_formula": "0", "length2_formula": "neck_width*2/3" },
    { "op": "add_midpoint", "name": "A11", "p1": "A5", "p2": "A10" },
    { "op": "add_midpoint", "name": "A12", "p1": "A10", "p2": "A2" },
    { "op": "add_midpoint", "name": "A13", "p1": "A11", "p2": "A12" },

    { "op": "add_point_of_intersection", "name": "A20", "p1": "A7", "p2": "A8" },

    { "op": "add_spline", "name": "ArmholeCurve", "p1": "A7", "p4": "A8",
      "angle1_formula": "-90", "length1_formula": "(armhole_depth-shoulder_drop)*2/3",
      "angle2_formula": "180", "length2_formula": "(half_chest-shoulder_width)*2/3" },
    { "op": "add_midpoint", "name": "A21", "p1": "A7", "p2": "A20" },
    { "op": "add_midpoint", "name": "A22", "p1": "A20", "p2": "A8" },
    { "op": "add_midpoint", "name": "A23", "p1": "A21", "p2": "A22" },

    { "op": "add_line", "p1": "A5", "p2": "A13" },
    { "op": "add_line", "p1": "A13", "p2": "A2" },
    { "op": "add_line", "p1": "A2", "p2": "A4" },
    { "op": "add_line", "p1": "A4", "p2": "A9" },
    { "op": "add_line", "p1": "A9", "p2": "A8" },
    { "op": "add_line", "p1": "A8", "p2": "A23" },
    { "op": "add_line", "p1": "A23", "p2": "A7" },
    { "op": "add_line", "p1": "A7", "p2": "A5" },

    {
      "op": "add_piece",
      "name": "ShirtFront",
      "points": ["A5", "A13", "A2", "A4", "A9", "A8", "A23", "A7"],
      "seam_allowance_formula": "0"
    }
  ]
